<?xml version="1.0" encoding="UTF-8"?>
<!-- Info.plist — carte d'identité du bundle .app.
     Copiée telle quelle dans NONP Transcription.app/Contents/ par build_app.sh. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>NONP Transcription</string>

    <key>CFBundleDisplayName</key>
    <string>NONP Transcription</string>

    <!-- Langue de l'application. Mesuré le 22/09 sur NONP Habillage : sans ces
         deux clés, macOS tient l'application pour anglaise et affiche EN ANGLAIS
         les menus qu'il fournit lui-même (Édition, Fenêtre, Aide, « Réglages… »,
         « Quitter »). L'application n'en déclare aucun : tout vient de macOS.
         Ces deux clés suffisent — vérifié à l'écran, aucun dossier fr.lproj
         n'est nécessaire. Garde de fabrication dans Scripts/build_app.sh. -->
    <key>CFBundleDevelopmentRegion</key>
    <string>fr</string>

    <key>CFBundleLocalizations</key>
    <array>
        <string>fr</string>
    </array>

    <!-- Nom du binaire dans Contents/MacOS/ -->
    <key>CFBundleExecutable</key>
    <string>NONPTranscription</string>

    <!-- Identifiant de PRODUCTION. Les builds de test reçoivent l'identifiant
         « com.nonp.transcription.test » appliqué par Scripts/build_app.sh, afin
         que macOS ne confonde jamais la build de test avec la version installée. -->
    <key>CFBundleIdentifier</key>
    <string>com.nonp.transcription</string>

    <!-- Icône de l'application (AppIcon.icns copié dans Resources/) -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <!-- Version affichée dans la fenêtre « À propos ». -->
    <key>CFBundleShortVersionString</key>
    <string>1.2.4</string>

    <key>CFBundleVersion</key>
    <string>11</string>

    <!-- macOS 14 minimum, cohérent avec Package.swift -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <!-- Rendu Retina net -->
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Application avec fenêtre normale (icône dans le Dock) -->
    <key>LSUIElement</key>
    <false/>
</dict>
</plist>
