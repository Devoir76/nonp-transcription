# ===== Compilation Swift / SwiftPM =====
.build/
.swiftpm/
Package.resolved

# ===== Application construite =====
dist/

# ===== Modèles Whisper (téléchargés, jamais versionnés — plusieurs Go) =====
# NB : les modèles vivent dans ~/Library/Application Support/, hors du dépôt.
# On n'exclut donc PAS un dossier nommé « Models/ » (cela masquerait par erreur
# le dossier de code source Sources/.../Models/). Les motifs *.bin suffisent.
*.bin
ggml-*.bin

# ===== Résultats de transcription =====
*.srt
*.txt
# (exception : on garde les éventuels fichiers de documentation .txt volontaires)
!LICENSE.txt

# ===== Médias source (jamais versionnés) =====
# Vidéos et audio déposés/transcrits : ne doivent jamais entrer dans le dépôt.
*.mp4
*.mov
*.mkv
*.avi
*.m4a
*.mp3
*.aac
*.ogg
*.opus
*.flac

# ===== Fichiers temporaires / de travail =====
*.wav
nonp-*.wav
*.tmp
*.log
tmp/
temp/
Resources/AppIcon.iconset/   # intermédiaire régénérable (on garde AppIcon.icns)

# ===== Données propres à macOS =====
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems

# ===== Fichiers locaux / sensibles =====
.env
.env.*
*.local
*.secret
*.key
*.pem
secrets/
config.local.*

# Config locale de l'assistant (chemins perso / coffre — hors dépôt public)
.claude/
CLAUDE.md

# ===== Éditeurs / IDE =====
.vscode/
.idea/
*.swp
xcuserdata/

# ===== Banc de test =====
# Exclusion CIBLÉE des seuls artefacts générés (PAS une exclusion globale Bench/).
# NB : gitignore n'accepte pas de commentaire en fin de ligne — motifs seuls.
#   Bench/clips/        : audio synthétique régénérable
#   Bench/results/      : sorties de transcription intermédiaires
#   Bench/results-real/ : sorties de vidéos réelles (contenus tiers + chemins locaux)
Bench/clips/
Bench/results/
Bench/results-real/
# À CONSERVER versionnables :
#  - les scripts du banc (*.sh, *.py) : aucun motif ne les exclut, donc suivis par défaut ;
#  - le golden-master Bench/golden/ : ré-inclusion explicite, car les règles globales
#    *.wav / *.srt / *.txt le masqueraient sinon.
!Bench/golden/
!Bench/golden/*.wav
!Bench/golden/*.srt
!Bench/golden/*.txt
!Bench/golden/*.json
!Bench/golden/*.md
